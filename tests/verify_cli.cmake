# Explicit CLI verification; CTest/framework integration belongs to issue #8.
if(NOT DEFINED BENCHCHECK OR NOT DEFINED REPORT_DIR)
    message(FATAL_ERROR "BENCHCHECK and REPORT_DIR are required")
endif()
file(MAKE_DIRECTORY "${REPORT_DIR}")

function(run_command expected_code expected_text)
    execute_process(
        COMMAND "${BENCHCHECK}" ${ARGN}
        WORKING_DIRECTORY "${REPORT_DIR}"
        RESULT_VARIABLE code
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error
        TIMEOUT 5
    )
    if(NOT "${code}" STREQUAL "${expected_code}")
        message(FATAL_ERROR "Expected exit ${expected_code}, got ${code}: ${output}${error}")
    endif()
    string(FIND "${output}${error}" "${expected_text}" match)
    if(match EQUAL -1)
        message(FATAL_ERROR "Missing '${expected_text}': ${output}${error}")
    endif()
endfunction()

function(run_case name expected_code expected_text)
    set(report "${REPORT_DIR}/${name}.md")
    file(REMOVE "${report}")
    run_command("${expected_code}" "${expected_text}" ${ARGN} --report "${report}")
    set(LAST_REPORT "${report}" PARENT_SCOPE)
endfunction()

function(check_report expected_text)
    if(NOT EXISTS "${LAST_REPORT}")
        message(FATAL_ERROR "Missing report: ${LAST_REPORT}")
    endif()
    file(READ "${LAST_REPORT}" report)
    string(FIND "${report}" "${expected_text}" match)
    if(match EQUAL -1)
        message(FATAL_ERROR "Missing '${expected_text}' in ${LAST_REPORT}: ${report}")
    endif()
endfunction()

run_case(normal 0 "Test result: PASS")
check_report("Measured voltage: 5 V")
check_report("All instruments are simulated")
check_report("Load input: disabled")
check_report("Supply output: disabled")

foreach(scenario IN ITEMS normal undervoltage overvoltage timeout)
    if(scenario STREQUAL "normal")
        set(code 0)
        set(status PASS)
    elseif(scenario STREQUAL "timeout")
        set(code 2)
        set(status ERROR)
    else()
        set(code 1)
        set(status FAIL)
    endif()
    run_case("${scenario}" "${code}" "Test result: ${status}" --scenario "${scenario}")
    check_report("Scenario: **${scenario}**")
    check_report("Result: **${status}**")
    check_report("Load input: disabled")
    check_report("Supply output: disabled")
    if(scenario STREQUAL "timeout")
        check_report("Measured voltage: unavailable (no reading acquired).")
        check_report("timed out")
    endif()
    file(READ "${LAST_REPORT}" first)
    run_case("${scenario}" "${code}" "Test result: ${status}" --scenario "${scenario}")
    file(READ "${LAST_REPORT}" second)
    if(NOT first STREQUAL second)
        message(FATAL_ERROR "Non-repeatable report for ${scenario}")
    endif()
endforeach()

run_case(custom 0 "Measured voltage: 12 V" --voltage 12 --current-limit 2 --load-current 1
    --min-voltage 11.9 --max-voltage 12.1)
check_report("Supply voltage | 12 V")
run_case(zero 0 "Test result: PASS" --voltage 0 --current-limit 0 --load-current 0
    --min-voltage 0 --max-voltage 0)
check_report("Measured voltage: 0 V")
run_case(maximum 0 "Test result: PASS" --voltage 30 --current-limit 5 --load-current 5
    --min-voltage 30 --max-voltage 30)
run_case(lower_boundary 0 "Test result: PASS" --voltage 4.9)
run_case(upper_boundary 0 "Test result: PASS" --voltage 5.1)
run_case(below_boundary 1 "Test result: FAIL" --voltage 4.899)
run_case(above_boundary 1 "Test result: FAIL" --voltage 5.101)

foreach(option IN ITEMS voltage current-limit load-current min-voltage max-voltage)
    foreach(value IN ITEMS -1 31 nan inf -inf)
        run_case("invalid_${option}_${value}" 2 "${option} must" "--${option}" "${value}")
        check_report("Result: **ERROR**")
        check_report("Measured voltage: unavailable")
        check_report("Load input: disabled")
        check_report("Supply output: disabled")
    endforeach()
endforeach()
run_case(reversed 2 "min-voltage must be less than or equal to max-voltage" --min-voltage 6)
run_case(excess_current 2 "load-current must not exceed current-limit" --load-current 0.6)

run_case(bad_number 2 "--voltage requires a numeric value" --voltage 5oops)
if(EXISTS "${LAST_REPORT}")
    message(FATAL_ERROR "Malformed CLI input created a report")
endif()
run_case(number_overflow 2 "--voltage requires a numeric value" --voltage 1e9999)
run_case(bad_scenario 2 "scenario must be" --scenario nonsense)
run_case(unknown 2 "Unknown option" --bogus value)
run_case(duplicate 2 "Duplicate option" --voltage 5 --voltage 6)
run_command(2 "Missing value for --voltage" --voltage)
run_command(2 "Missing value for --voltage" --voltage --scenario normal)

run_case(help 0 "Usage: benchcheck" --help)
if(EXISTS "${LAST_REPORT}")
    message(FATAL_ERROR "Help created a report")
endif()
run_command(2 "ERROR: Cannot open report for writing" --report "${REPORT_DIR}")
run_command(2 "ERROR: Cannot open report for writing" --report "${REPORT_DIR}/missing-parent/report.md")
if(EXISTS "/dev/full")
    run_command(2 "ERROR: Cannot finish writing report" --report /dev/full)
endif()
run_case("report with spaces" 0 "Test result: PASS")
check_report("Result: **PASS**")

message(STATUS "All CLI scenario, validation, report, and exit-code checks passed.")
